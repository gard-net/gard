<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gard.Core</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>Gard.Core</PackageId>
    <Version>0.2.4</Version>
    <Authors>Marco Rojas</Authors>
    <Description>Platform-neutral core for the Landspeed Protocol (LSP/1.2): framing, transport, mDNS discovery, handshake and measurement engine. Used by gard (CLI) and reference apps.</Description>
    <PackageProjectUrl>https://github.com/gard-net/gard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gard-net/gard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>network;lan;throughput;latency;jitter;mdns;lsp;landspeed</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
  </ItemGroup>

</Project>
